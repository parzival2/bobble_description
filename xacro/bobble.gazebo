<?xml version="1.0"?>
<robot name="bobblebot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <gazebo reference="bno055_imu_link">
        <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        <topic>/bobble/imu</topic>
        <enable_metrics>true</enable_metrics>
        <gz_frame_id>imu_link</gz_frame_id>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <update_rate>30</update_rate>
            <joint_name>left_wheel_hinge</joint_name>
            <joint_name>right_wheel_hinge</joint_name>
        </plugin> 
    </gazebo>

    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="left_wheel_hinge">
          <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="right_wheel_hinge">
          <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
    </ros2_control>
    
    <gazebo>
        <!-- Joint state publisher -->
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <ros>                
            <remapping>/robot_description:=/bobble/robot_description</remapping>
          </ros>
          <parameters>$(find bobble_description)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>
</robot>